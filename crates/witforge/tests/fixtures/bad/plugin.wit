package example:bad;

interface types {
    resource handle {
        read: func() -> list<u8>;
    }

    record pair {
        both: tuple<u32, u32>,
        letter: char,
    }

    record table {
        rows: map<string, u32>,
    }
}

world plugin {
    record local {
        x: u32,
    }
    export types;
}
