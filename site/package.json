{
  "name": "witforge-site",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Documentation and promotional site for witforge",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:scripts": "node --test scripts/test-scripts.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "0.43.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.4",
    "typescript": "5.9.3"
  }
}
