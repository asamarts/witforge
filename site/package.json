{
  "name": "witforge-site",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Documentation and promotional site for witforge",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "emit:redirects": "node scripts/emit-redirects.mjs",
    "check:links": "node scripts/check-links.mjs",
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && astro build && node scripts/emit-redirects.mjs",
    "preview": "astro preview",
    "check": "node scripts/sync-docs.mjs && astro check",
    "test:scripts": "node --test scripts/test-scripts.mjs",
    "verify": "npm run test:scripts && npm run check && npm run build && npm run check:links",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "0.43.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
