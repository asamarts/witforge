---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';

const title = 'Page not found | witforge';
const description = 'The requested witforge documentation page could not be found.';
---

<BaseLayout title={title} description={description} canonical={null} indexInSearch={false}>
  <meta slot="head" name="robots" content="noindex" />
  <section class="not-found wrap">
    <span class="sec-kicker">404 &middot; Page not found</span>
    <h1>That page does not exist</h1>
    <p class="sec-lede">
      The link may have moved or been mistyped. Jump straight into the documentation, quickstart,
      outputs matrix, or diagnostic code reference below.
    </p>
    <div class="nf-actions">
      <a class="btn btn-primary" href={withBase('/docs/')}>Documentation overview</a>
      <a class="btn btn-ghost" href={withBase('/docs/quickstart/')}>Quickstart</a>
      <a class="btn btn-ghost" href={withBase('/outputs/')}>Outputs matrix</a>
      <a class="btn btn-ghost" href={withBase('/docs/reference/')}>CLI reference</a>
      <a class="btn btn-ghost" href={withBase('/docs/diagnostics/')}>Diagnostic codes</a>
      <a class="btn btn-ghost" href={withBase('/')}>Return home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(56px, 9vw, 116px);
    max-width: 48rem;
  }

  .not-found h1 {
    margin-top: var(--s3);
  }

  .not-found .sec-lede {
    margin-top: var(--s4);
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--s5);
  }
</style>
