---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvolutionDiagram from '../components/EvolutionDiagram.astro';
import {
  EVOLUTION_RULES,
  OPT_IN_PROFILES,
  TYPE_MAPPING_GROUPS,
} from '../data/matrices';
import {
  WORKSPACE_VERSION,
  canonicalUrl,
  withBase,
} from '../lib/site';

const title = 'Outputs and Evolution Matrix | witforge';
const description =
  'Complete WIT-to-Rust, Protobuf, JSON Schema, and checked glue type mappings alongside 4-view contract diff and adapter compatibility verdicts.';
---

<BaseLayout title={title} description={description} canonical={canonicalUrl('/outputs/')}>
  <!-- Header band -->
  <section class="page-hero">
    <div class="wrap">
      <span class="sec-kicker">Outputs and compatibility &middot; v{WORKSPACE_VERSION}</span>
      <h1 class="page-title">WIT type mappings and evolution verdicts</h1>
      <p class="sec-lede page-lede">
        Inspect exactly how every supported WIT type compiles into Rust, Protobuf, JSON Schema,
        and checked glue, and how schema edits behave across wire lockfiles, 4-view diffs, and
        generated{' '}<code>convert.rs</code>{' '}adapters.
      </p>
      <div class="jump-links">
        <a class="btn btn-primary" href="#type-matrix">Type mapping matrix</a>
        <a class="btn btn-ghost" href="#opt-in-profiles">Opt-in profiles</a>
        <a class="btn btn-ghost" href="#evolution-lifecycle">Evolution lifecycle</a>
        <a class="btn btn-ghost" href="#diff-matrix">Diff verdicts</a>
      </div>
    </div>
  </section>

  <!-- Section 1: WIT-to-Projection Type Mapping Matrix -->
  <section id="type-matrix" class="section wrap">
    <div class="section-head">
      <div>
        <span class="sec-kicker">Type projection</span>
        <h2>WIT to Rust, Protobuf, JSON Schema, and Glue</h2>
      </div>
      <p class="sec-lede">
        Every row reflects the normative emitter specification. Unsupported constructs (resources,
        handles, tuples, futures, streams, async functions, and unsupported map keys) are rejected
        up front by{' '}<code>witforge check</code>.
      </p>
    </div>

    <div class="matrix-shell" data-tabs>
      <div class="matrix-bar">
        <div role="tablist" aria-label="WIT type categories">
          {
            TYPE_MAPPING_GROUPS.map((group, index) => (
              <button
                type="button"
                role="tab"
                id={`type-tab-${group.id}`}
                aria-controls={`type-panel-${group.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
              >
                {group.label} ({group.rows.length})
              </button>
            ))
          }
        </div>
      </div>

      {
        TYPE_MAPPING_GROUPS.map((group, index) => (
          <div
            role="tabpanel"
            id={`type-panel-${group.id}`}
            aria-labelledby={`type-tab-${group.id}`}
            hidden={index !== 0}
            class="matrix-panel"
          >
            <div class="panel-intro">
              <h3>{group.label}</h3>
              <p>{group.description}</p>
            </div>
            <div class="table-scroll" tabindex="0">
              <table class="spec-table">
                <thead>
                  <tr>
                    <th scope="col">WIT construct</th>
                    <th scope="col">Plain Rust</th>
                    <th scope="col">Protobuf (proto3)</th>
                    <th scope="col">JSON Schema</th>
                    <th scope="col">Checked glue and notes</th>
                  </tr>
                </thead>
                <tbody>
                  {group.rows.map((row) => (
                    <tr>
                      <td><code>{row.wit}</code></td>
                      <td><code>{row.rust}</code></td>
                      <td><code>{row.proto}</code></td>
                      <td><code>{row.schema}</code></td>
                      <td>{row.glueAndNotes}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Section 2: Opt-in Profiles -->
  <section id="opt-in-profiles" class="section section-tinted">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="sec-kicker">Opt-in emitter options</span>
          <h2>Explicit profiles, zero surprise dependencies</h2>
        </div>
        <p class="sec-lede">
          Default plain Rust output requires no external crates and derives only{' '}
          <code>Debug, Clone, PartialEq</code>. Enable additional traits,{' '}<code>no_std</code>,
          or Draft 2020-12 JSON Schema per project in{' '}<code>witforge.toml</code>{' '}or via CLI
          flags.
        </p>
      </div>

      <div class="profile-grid">
        {
          OPT_IN_PROFILES.map((profile) => (
            <article class="profile-card">
              <div class="profile-top">
                <code class="profile-flag">{profile.flag}</code>
                <span class="profile-scope">{profile.scope}</span>
              </div>
              <p>{profile.summary}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 3: Evolution Lifecycle SVG -->
  <section id="evolution-lifecycle" class="section wrap">
    <div class="section-head">
      <div>
        <span class="sec-kicker">Versioned workflow</span>
        <h2>How contracts evolve without shifting wire numbers</h2>
      </div>
      <p class="sec-lede">
        Released directories are immutable. A minor change lives in a new sibling directory that
        continues the prior{' '}<code>wire.lock</code>; a wire-breaking change starts a new major
        package.
      </p>
    </div>
    <EvolutionDiagram />
  </section>

  <!-- Section 4: Four-View Compatibility & Diff Verdict Matrix -->
  <section id="diff-matrix" class="section section-tinted">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="sec-kicker">Compatibility verdicts</span>
          <h2>Four-view diff and adapter behavior</h2>
        </div>
        <p class="sec-lede">
          <code>witforge diff --check</code>{' '}gates{' '}<code>wire,source,api</code>{' '}by
          default. Select binary decode gating explicitly with{' '}
          <code>--check=wire,decode</code>{' '}or{' '}
          <code>[project.&lt;name&gt;.policy]</code>.
        </p>
      </div>

      <div class="matrix-shell">
        <div class="table-scroll" tabindex="0">
          <table class="spec-table evo-table">
            <thead>
              <tr>
                <th scope="col">Contract change (within one major)</th>
                <th scope="col">wire</th>
                <th scope="col">source</th>
                <th scope="col">api</th>
                <th scope="col">decode (binary)</th>
                <th scope="col">convert.rs adapter</th>
              </tr>
            </thead>
            <tbody>
              {
                EVOLUTION_RULES.map((row) => (
                  <tr>
                    <td class="change-col">{row.change}</td>
                    <td>
                      <span class:list={['badge', `badge-${row.wire.tone}`]}>{row.wire.label}</span>
                    </td>
                    <td>
                      <span class:list={['badge', `badge-${row.source.tone}`]}>
                        {row.source.label}
                      </span>
                    </td>
                    <td>
                      <span class:list={['badge', `badge-${row.api.tone}`]}>{row.api.label}</span>
                    </td>
                    <td>
                      <span class:list={['badge', `badge-${row.decode.tone}`]}>
                        {row.decode.label}
                      </span>
                    </td>
                    <td>{row.convert}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="note-box">
        <h3>Key boundary: binary decode vs in-process convert.rs</h3>
        <p>
          <code>convert.rs</code>{' '}converts plain Rust values inside one process and defaults an
          added or removed{' '}<code>list&lt;u8&gt;</code>{' '}field to{' '}<code>Vec::new()</code>.
          On the wire, required{' '}<code>list&lt;u8&gt;</code>{' '}is proto3{' '}
          <code>optional bytes</code>, so a reader rejects an omitted field from the opposite side
          with{' '}<code>MissingField</code>{' '}(reported as{' '}
          <code>decode: BREAKING (new&lt;-old)</code>{' '}on addition and{' '}
          <code>decode: BREAKING (old&lt;-new)</code>{' '}on removal). Strict proto3-JSON parsers
          also reject unknown fields unless configured to ignore them.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 5: Deep-dive guide links -->
  <section class="section wrap">
    <div class="deep-links">
      <div>
        <h2>Continue with the normative guides</h2>
        <p class="sec-lede">
          Read the full authoring rules, committed output walkthroughs, and cross-language decode
          requirements.
        </p>
      </div>
      <div class="deep-actions">
        <a class="btn btn-primary" href={withBase('/docs/generated-output/')}>Real generated output</a>
        <a class="btn btn-ghost" href={withBase('/docs/contract-authoring/')}>Contract authoring</a>
        <a class="btn btn-ghost" href={withBase('/docs/evolution/')}>Evolving contracts</a>
        <a class="btn btn-ghost" href={withBase('/docs/json-projections/')}>JSON projections</a>
        <a class="btn btn-ghost" href={withBase('/docs/non-rust/')}>Non-Rust implementations</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(40px, 6vw, 72px) clamp(32px, 5vw, 56px);
    background:
      radial-gradient(560px 260px at 86% 12%, color-mix(in oklab, var(--accent) 11%, transparent), transparent 72%),
      var(--bg);
    border-bottom: 1px solid var(--rule);
  }

  .page-title {
    margin-top: var(--s3);
    max-width: 44rem;
  }

  .page-lede {
    margin-top: var(--s4);
  }

  .jump-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--s5);
  }

  .section {
    padding-block: clamp(44px, 6vw, 76px);
  }

  .section-tinted {
    background: var(--surface);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s4);
    margin-bottom: var(--s5);
  }

  .section-head h2 {
    margin-top: var(--s3);
  }

  @media (min-width: 900px) {
    .section-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: end;
      gap: var(--s6);
    }
  }

  .matrix-shell {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .matrix-bar {
    padding: var(--s3) var(--s4);
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
  }

  .panel-intro {
    padding: var(--s4) var(--s4) var(--s3);
    border-bottom: 1px solid var(--rule);
    background: var(--surface-2);
  }

  .panel-intro p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.92rem;
    max-width: 58rem;
  }

  .table-scroll {
    width: 100%;
    overflow-x: auto;
  }

  .table-scroll:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .spec-table th,
  .spec-table td {
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
  }

  .spec-table thead th {
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .spec-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .spec-table td code {
    padding: 0;
    background: transparent;
    color: var(--ink);
    font-size: 0.82rem;
    white-space: normal;
    word-break: break-word;
  }

  .change-col {
    color: var(--ink);
    font-weight: 600;
    min-width: 220px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 9px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-code);
    font-size: 0.74rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .badge-ok {
    background: var(--ok-wash);
    border-color: var(--ok-border);
    color: var(--ok);
  }

  .badge-err {
    background: var(--err-wash);
    border-color: var(--err-border);
    color: var(--err);
  }

  .badge-warn {
    background: var(--warn-wash);
    border-color: var(--warn-border);
    color: var(--warn);
  }

  .badge-neutral {
    background: var(--surface-2);
    border-color: var(--rule);
    color: var(--muted);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    gap: var(--s4);
  }

  .profile-card {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    padding: var(--s4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: var(--shadow-card);
  }

  .profile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .profile-flag {
    padding: 3px 8px;
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-sm);
    background: var(--accent-wash);
    color: var(--accent-strong);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .profile-scope {
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.75rem;
  }

  .profile-card p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.52;
  }

  .note-box {
    margin-top: var(--s5);
    padding: var(--s4) var(--s5);
    border: 1px solid var(--wire-border);
    border-radius: var(--radius);
    background: var(--wire-wash);
  }

  .note-box h3 {
    color: var(--ink);
    font-size: 1rem;
  }

  .note-box p {
    margin-top: var(--s2);
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.58;
  }

  .deep-links {
    display: flex;
    flex-direction: column;
    gap: var(--s5);
    padding: var(--s6);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius);
    background: var(--accent-wash);
  }

  .deep-links .sec-lede {
    margin-top: var(--s2);
  }

  .deep-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* When JS is disabled, hide dead tab bar and separate revealed category panels cleanly */
  :global(:root:not(.js)) .matrix-bar {
    display: none;
  }

  :global(:root:not(.js)) .matrix-panel + .matrix-panel {
    border-top: 2px solid var(--rule);
  }
</style>
