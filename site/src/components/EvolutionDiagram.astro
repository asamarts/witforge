---
// Zero-JS accessible inline SVG illustrating witforge's versioned contract lifecycle.
---

<figure class="evo-figure">
  <svg
    class="evo-svg"
    viewBox="0 0 960 208"
    fill="none"
    role="img"
    aria-labelledby="wf-evo-title wf-evo-desc"
  >
    <title id="wf-evo-title">witforge contract evolution lifecycle</title>
    <desc id="wf-evo-desc">
      Five-step contract evolution flow: a frozen released v0.1 baseline is copied by witforge
      new-version into draft v0.2, validated and locked against v0.1 wire numbers, reviewed with
      4-view diff and convert.rs adapters, and finally marked released and enforced by witforge
      freeze in CI.
    </desc>

    <defs>
      <marker
        id="wf-evo-arrow"
        viewBox="0 0 10 10"
        refX="8.5"
        refY="5"
        markerWidth="6.5"
        markerHeight="6.5"
        orient="auto-start-reverse"
      >
        <path d="M1 1.5L8.5 5L1 8.5Z" fill="var(--accent)" />
      </marker>
    </defs>

    <!-- Step 1: Released v0.1 -->
    <g>
      <rect x="16" y="34" width="164" height="132" rx="10" class="evo-card-frozen" />
      <rect x="28" y="48" width="72" height="20" rx="10" class="pill-ok" />
      <text x="64" y="61" text-anchor="middle" class="pill-ok-text">RELEASED</text>
      <text x="28" y="94" class="evo-title">wit/v0.1</text>
      <text x="28" y="116" class="evo-sub">Immutable WIT</text>
      <text x="28" y="134" class="evo-sub">+ wire.lock</text>
      <text x="28" y="152" class="evo-sub">Frozen in Git</text>
    </g>

    <path d="M180 100 L204 100" class="evo-edge" marker-end="url(#wf-evo-arrow)" />

    <!-- Step 2: new-version -->
    <g>
      <rect x="208" y="34" width="164" height="132" rx="10" class="evo-card" />
      <rect x="220" y="48" width="60" height="20" rx="10" class="pill-accent" />
      <text x="250" y="61" text-anchor="middle" class="pill-accent-text">STEP 1</text>
      <text x="220" y="94" class="evo-title">new-version</text>
      <text x="220" y="116" class="evo-sub">Creates wit/v0.2</text>
      <text x="220" y="134" class="evo-sub">Copies lock + deps</text>
      <text x="220" y="152" class="evo-sub">Edit draft safely</text>
    </g>

    <path d="M372 100 L396 100" class="evo-edge" marker-end="url(#wf-evo-arrow)" />

    <!-- Step 3: lock & check -->
    <g>
      <rect x="400" y="34" width="164" height="132" rx="10" class="evo-card" />
      <rect x="412" y="48" width="60" height="20" rx="10" class="pill-accent" />
      <text x="442" y="61" text-anchor="middle" class="pill-accent-text">STEP 2</text>
      <text x="412" y="94" class="evo-title">lock &amp; check</text>
      <text x="412" y="116" class="evo-sub">--against v0.1</text>
      <text x="412" y="134" class="evo-sub">Append-only tags</text>
      <text x="412" y="152" class="evo-sub">+ deps sync</text>
    </g>

    <path d="M564 100 L588 100" class="evo-edge" marker-end="url(#wf-evo-arrow)" />

    <!-- Step 4: diff & convert -->
    <g>
      <rect x="592" y="34" width="164" height="132" rx="10" class="evo-card-active" />
      <rect x="604" y="48" width="60" height="20" rx="10" class="pill-wire" />
      <text x="634" y="61" text-anchor="middle" class="pill-wire-text">STEP 3</text>
      <text x="604" y="94" class="evo-title">diff &amp; generate</text>
      <text x="604" y="116" class="evo-sub">4-view diff / policy</text>
      <text x="604" y="134" class="evo-sub">Emits convert.rs</text>
      <text x="604" y="152" class="evo-sub">--check in CI</text>
    </g>

    <path d="M756 100 L780 100" class="evo-edge" marker-end="url(#wf-evo-arrow)" />

    <!-- Step 5: release & freeze -->
    <g>
      <rect x="784" y="34" width="160" height="132" rx="10" class="evo-card-frozen" />
      <rect x="796" y="48" width="76" height="20" rx="10" class="pill-ok" />
      <text x="834" y="61" text-anchor="middle" class="pill-ok-text">FROZEN</text>
      <text x="796" y="94" class="evo-title">release &amp; freeze</text>
      <text x="796" y="116" class="evo-sub">Records wit/v0.2</text>
      <text x="796" y="134" class="evo-sub">in wit/released</text>
      <text x="796" y="152" class="evo-sub">History checked</text>
    </g>
  </svg>
</figure>

<style>
  .evo-figure {
    margin: 0;
    padding: var(--s5);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    overflow-x: auto;
  }

  .evo-svg {
    display: block;
    width: 100%;
    min-width: 700px;
    height: auto;
  }

  .evo-card {
    fill: var(--bg);
    stroke: var(--rule);
    stroke-width: 1.5;
  }

  .evo-card-active {
    fill: var(--wire-wash);
    stroke: var(--wire-border);
    stroke-width: 1.6;
  }

  .evo-card-frozen {
    fill: var(--ok-wash);
    stroke: var(--ok-border);
    stroke-width: 1.6;
  }

  .pill-accent {
    fill: var(--accent-wash);
    stroke: var(--accent-border);
    stroke-width: 1;
  }

  .pill-accent-text {
    fill: var(--accent-strong);
    font-family: var(--font-code);
    font-size: 10px;
    font-weight: 700;
  }

  .pill-ok {
    fill: var(--bg);
    stroke: var(--ok-border);
    stroke-width: 1;
  }

  .pill-ok-text {
    fill: var(--ok);
    font-family: var(--font-code);
    font-size: 10px;
    font-weight: 700;
  }

  .pill-wire {
    fill: var(--bg);
    stroke: var(--wire-border);
    stroke-width: 1;
  }

  .pill-wire-text {
    fill: var(--wire);
    font-family: var(--font-code);
    font-size: 10px;
    font-weight: 700;
  }

  .evo-title {
    fill: var(--ink);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
  }

  .evo-sub {
    fill: var(--muted);
    font-family: var(--font-code);
    font-size: 11px;
  }

  .evo-edge {
    stroke: var(--accent);
    stroke-width: 1.9;
  }
</style>
