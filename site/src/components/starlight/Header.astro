---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteNav from '../SiteNav.astro';
import ThemeToggle from '../ThemeToggle.astro';
---

<SiteNav as="div">
  <div slot="search" class="docs-search">
    <Search />
  </div>
  <ThemeToggle slot="end" />
</SiteNav>

<style>
  .docs-search {
    display: flex;
    align-items: center;
  }

  .docs-search :global(button[data-open-modal]:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  @media (min-width: 50rem) {
    .docs-search :global(button[data-open-modal]) {
      width: 12rem;
      height: 34px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-strong);
      background: var(--surface);
      color: var(--muted);
      font-size: 0.84rem;
    }

    .docs-search :global(button[data-open-modal]:hover) {
      border-color: var(--accent);
      color: var(--ink);
    }
  }

  @media (max-width: 1180px) and (min-width: 50rem) {
    .docs-search :global(button[data-open-modal]) {
      min-width: 0;
      width: 9.5rem;
    }
  }

  @media (max-width: 960px) and (min-width: 50rem) {
    .docs-search :global(button[data-open-modal]) {
      width: auto;
      padding-inline: 8px;
    }

    .docs-search :global(button[data-open-modal] > span),
    .docs-search :global(button[data-open-modal] kbd) {
      display: none;
    }
  }

  @media (max-width: 49.99rem) {
    .docs-search :global(button[data-open-modal]) {
      width: 34px;
      height: 34px;
      padding: 0;
      justify-content: center;
      border: 1px solid transparent;
      border-radius: var(--radius-sm);
      background: transparent;
      color: var(--muted);
    }

    .docs-search :global(button[data-open-modal]:hover) {
      background: var(--surface-2);
      border-color: var(--rule);
      color: var(--ink);
    }

    :global(:root[data-has-sidebar] .header .site-nav) {
      padding-inline-end: calc(var(--gutter) + var(--sl-menu-button-size) + 8px);
    }

    :global(:root[data-has-sidebar] .header .nav-version),
    :global(:root[data-has-sidebar] .header .nav-icon) {
      display: none;
    }
  }
</style>
