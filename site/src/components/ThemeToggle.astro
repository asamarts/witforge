---
import { THEME_COLOR_DARK, THEME_COLOR_LIGHT } from '../lib/site';
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Switch color theme"
  title="Switch color theme"
>
  <svg
    class="icon-moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg
    class="icon-sun"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background-color 120ms var(--ease), color 120ms var(--ease), border-color 120ms var(--ease);
  }

  .theme-toggle:hover {
    background: var(--surface-2);
    border-color: var(--rule);
    color: var(--ink);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .theme-toggle .icon-sun {
    display: none;
  }

  @media screen and (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .icon-sun {
      display: inline;
    }

    :global(:root:not([data-theme='light'])) .theme-toggle .icon-moon {
      display: none;
    }
  }

  @media screen {
    :global(:root[data-theme='dark']) .theme-toggle .icon-sun {
      display: inline;
    }

    :global(:root[data-theme='dark']) .theme-toggle .icon-moon {
      display: none;
    }
  }
</style>

<script is:inline define:vars={{ THEME_COLOR_DARK, THEME_COLOR_LIGHT }}>
  (() => {
    document.documentElement.classList.add('js');
    const mq = window.matchMedia('(prefers-color-scheme: dark)');

    const currentTheme = () => {
      const attr = document.documentElement.dataset.theme;
      if (attr === 'light' || attr === 'dark') return attr;
      try {
        const saved = localStorage.getItem('starlight-theme');
        if (saved === 'light' || saved === 'dark') return saved;
      } catch {
        // ignore storage errors
      }
      return mq.matches ? 'dark' : 'light';
    };

    const syncUi = () => {
      const theme = currentTheme();
      const dark = theme === 'dark';
      if (document.documentElement.dataset.theme !== theme) {
        document.documentElement.dataset.theme = theme;
      }
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) {
        meta.setAttribute('content', dark ? THEME_COLOR_DARK : THEME_COLOR_LIGHT);
      }
      for (const button of document.querySelectorAll('[data-theme-toggle]')) {
        const label = dark ? 'Switch to light theme' : 'Switch to dark theme';
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      }
    };

    for (const button of document.querySelectorAll('[data-theme-toggle]')) {
      if (button.dataset.bound === '1') continue;
      button.dataset.bound = '1';
      button.addEventListener('click', () => {
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {
          // ignore storage restrictions
        }
        if (window.StarlightThemeProvider?.updatePickers) {
          window.StarlightThemeProvider.updatePickers(next);
        }
        syncUi();
      });
    }

    syncUi();

    if (!window.__wfThemeObserverBound) {
      window.__wfThemeObserverBound = true;
      new MutationObserver(syncUi).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
    }
  })();
</script>
