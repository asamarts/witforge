---
import SiteLogo from './SiteLogo.astro';
import {
  DOCS_RS_URL,
  RELEASE_TAG_URL,
  REPO_URL,
  WORKSPACE_VERSION,
  withBase,
} from '../lib/site';

interface Props {
  as?: 'header' | 'div';
}

const { as: Wrapper = 'header' } = Astro.props;
const rawPath = Astro.url.pathname;
const currentPath = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;

const navItems = [
  { label: 'Docs', href: withBase('/docs/') },
  { label: 'Quickstart', href: withBase('/docs/quickstart/') },
  { label: 'Outputs', href: withBase('/outputs/') },
  { label: 'Reference', href: withBase('/docs/reference/') },
];

function isItemActive(href: string): boolean {
  const docsRoot = withBase('/docs/');
  const quickstartPath = withBase('/docs/quickstart/');
  const referencePath = withBase('/docs/reference/');
  if (href === docsRoot) {
    return (
      currentPath.startsWith(docsRoot) &&
      currentPath !== quickstartPath &&
      currentPath !== referencePath
    );
  }
  return currentPath === href || currentPath.startsWith(href);
}
---

<Wrapper class="site-header">
  <nav class="site-nav" aria-label="Primary">
    <a class="brand" href={withBase('/')} aria-label="witforge home">
      <SiteLogo id="nav" size={28} />
    </a>

    <ul class="nav-links" role="list">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isItemActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={DOCS_RS_URL} target="_blank" rel="noopener noreferrer">
          docs.rs
        </a>
      </li>
    </ul>

    <div class="nav-end">
      <slot name="search" />
      <a
        class="nav-version"
        href={RELEASE_TAG_URL}
        target="_blank"
        rel="noopener noreferrer"
        title={`witforge v${WORKSPACE_VERSION} release notes`}
      >
        v{WORKSPACE_VERSION}
      </a>
      <a
        class="nav-icon"
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="witforge on GitHub"
        title="witforge on GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
      <slot name="end" />
    </div>
  </nav>
</Wrapper>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 18px;
    height: var(--nav-h);
    max-width: calc(var(--page) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .brand:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .nav-links {
    display: flex;
    align-items: stretch;
    gap: 18px;
    height: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-links li {
    display: flex;
    flex-shrink: 0;
    margin: 0;
  }

  .nav-links a {
    display: flex;
    align-items: center;
    border-top: 2px solid transparent;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 120ms var(--ease), border-color 120ms var(--ease);
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-links a[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
    border-bottom-color: var(--accent);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    flex-shrink: 0;
  }

  .nav-version {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-pill);
    background: var(--accent-wash);
    color: var(--accent-strong);
    font-family: var(--font-code);
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 120ms var(--ease), background-color 120ms var(--ease);
  }

  .nav-version:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--muted);
    text-decoration: none;
    transition: background-color 120ms var(--ease), color 120ms var(--ease), border-color 120ms var(--ease);
  }

  .nav-icon:hover {
    background: var(--surface-2);
    border-color: var(--rule);
    color: var(--ink);
  }

  @media (max-width: 1080px) {
    .nav-version {
      display: none;
    }

    .site-nav {
      gap: 12px;
    }

    .nav-links {
      gap: 14px;
    }
  }

  @media (max-width: 820px) {
    .site-nav {
      gap: 10px;
    }

    .nav-links {
      gap: 12px;
      padding-inline-end: 18px;
      font-size: 0.86rem;
      mask-image: linear-gradient(to right, #000 88%, transparent);
      -webkit-mask-image: linear-gradient(to right, #000 88%, transparent);
    }
  }

  @media (max-width: 480px) {
    .nav-icon {
      display: none;
    }
  }
</style>
