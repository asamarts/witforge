---
import SiteLogo from './SiteLogo.astro';
import {
  CRATES_CLI_URL,
  DOCS_RS_BUILD_URL,
  DOCS_RS_URL,
  REPO_URL,
  WORKSPACE_MSRV,
  WORKSPACE_VERSION,
  withBase,
} from '../lib/site';

interface FooterColumn {
  title: string;
  links: Array<[string, string, boolean?]>;
}

const columns: FooterColumn[] = [
  {
    title: 'Documentation',
    links: [
      ['Overview', withBase('/docs/')],
      ['Choosing witforge', withBase('/docs/choosing-witforge/')],
      ['Quickstart', withBase('/docs/quickstart/')],
      ['Runnable examples', withBase('/docs/examples/')],
      ['Contract authoring', withBase('/docs/contract-authoring/')],
      ['Configuring generation', withBase('/docs/generation/')],
      ['Wiring and installation', withBase('/docs/wiring/')],
      ['Real generated output', withBase('/docs/generated-output/')],
    ],
  },
  {
    title: 'Evolution and Interop',
    links: [
      ['Outputs matrix', withBase('/outputs/')],
      ['Evolving contracts', withBase('/docs/evolution/')],
      ['CI and release freeze', withBase('/docs/ci/')],
      ['Release migration', withBase('/docs/migration/')],
      ['Non-Rust implementations', withBase('/docs/non-rust/')],
      ['JSON projections', withBase('/docs/json-projections/')],
      ['Component Model boundary', withBase('/docs/component-model/')],
    ],
  },
  {
    title: 'Reference',
    links: [
      ['CLI and config reference', withBase('/docs/reference/')],
      ['Diagnostic codes', withBase('/docs/diagnostics/')],
      ['llms.txt', withBase('/llms.txt')],
      ['llms-full.txt', withBase('/llms-full.txt')],
      ['docs.rs (witforge)', DOCS_RS_URL, true],
      ['docs.rs (witforge-build)', DOCS_RS_BUILD_URL, true],
      ['crates.io', CRATES_CLI_URL, true],
      ['GitHub', REPO_URL, true],
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-logo" href={withBase('/')} aria-label="witforge home">
          <SiteLogo id="footer" size={26} />
        </a>
        <p class="footer-blurb">
          WIT-first contract compiler for deterministic Rust, Protobuf, JSON Schema, checked glue,
          Markdown docs, and version adapters.
        </p>
        <p class="footer-meta">
          v{WORKSPACE_VERSION} &middot; Rust MSRV {WORKSPACE_MSRV} &middot; Apache-2.0 / MIT
        </p>
      </div>

      <div class="footer-cols">
        {
          columns.map((col) => (
            <nav class="footer-col" aria-label={col.title}>
              <h2>{col.title}</h2>
              <ul role="list">
                {col.links.map(([label, href, ext]) => (
                  <li>
                    <a
                      href={href}
                      target={ext ? '_blank' : undefined}
                      rel={ext ? 'noopener noreferrer' : undefined}
                    >
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--s7) var(--s6);
    border-top: 1px solid var(--rule);
    background: var(--surface);
    font-size: var(--t-small);
  }

  .footer-grid {
    display: grid;
    gap: var(--s6);
  }

  @media (min-width: 960px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 2fr);
      gap: var(--s7);
    }
  }

  .footer-logo {
    display: inline-flex;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .footer-blurb {
    margin-top: var(--s3);
    max-width: 26rem;
    color: var(--muted);
    line-height: 1.58;
  }

  .footer-meta {
    margin-top: var(--s3);
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.8rem;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--s5);
  }

  .footer-col h2 {
    margin: 0 0 var(--s3);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-col a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
  }

  .footer-col a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
